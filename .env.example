# =============================================================================
# ATENÇÃO — SEGURANÇA: USO ESTRITAMENTE LOCAL
#
# As variáveis VITE_* são embutidas no bundle JavaScript pelo Vite e ficam
# EXPOSTAS no código enviado ao browser. O login (AUTH_*) não usa esse prefixo.
#
# ► NÃO publique este projeto na internet com chaves reais no .env.
# ► NÃO faça commit do arquivo .env (ele já está no .gitignore).
# ► NÃO compartilhe o .env com outras pessoas.
#
# Use exclusivamente em ambiente local (localhost).
# =============================================================================

# Copie este arquivo para .env e preencha os valores antes de rodar o projeto.

# Chave da API do provedor LLM escolhido.
# OpenRouter: https://openrouter.ai/keys
# OpenAI:     https://platform.openai.com/api-keys
VITE_LLM_API_KEY=

# Endpoint do provedor (compatível com o formato de chat completions da OpenAI).
# OpenRouter: https://openrouter.ai/api/v1/chat/completions
# OpenAI:     https://api.openai.com/v1/chat/completions
VITE_LLM_ENDPOINT=

# Modelo padrão usado no chat e nas chamadas automáticas.
# OpenRouter: veja slugs em https://openrouter.ai/models (ex.: google/gemini-2.5-flash-lite-preview-09-2025:nitro - rápido e barato)
# OpenAI:     ex. gpt-5-nano
VITE_LLM_MODEL=

# Valor estimado de IPTU (R$) aplicado quando o imóvel não informa o IPTU.
# Padrão: 80
VITE_IPTU_ESTIMADO=80

# -----------------------------------------------------------------------------
# Login (um usuário só). Estas variáveis NÃO usam o prefixo VITE_: ficam no
# processo do servidor e não entram no JavaScript do browser.
#
# Senha local do exemplo: dev
# Para gerar outra: npm run hash-password
# O bcrypt vai em base64 porque o $ quebraria o Compose.
# Girar AUTH_SECRET derruba as sessões e exige recriar o PostgREST.
# Girar só o hash não desloga.
#
# Se a senha foi trocada na tela, o hash do banco vale no lugar desta variável.
# Para o ambiente voltar a valer:
#   DELETE FROM auth.painel_config WHERE chave = 'password_hash';
# -----------------------------------------------------------------------------
AUTH_EMAIL=seu@email.com
AUTH_PASSWORD_HASH=JDJiJDEyJFQxZXN1TFRRMGwuVXg0OXVFMTlJYWVDY21sY29yd3I3ZmljTFhGdXM1MG5qZ1JXQ1FYQ2J5
AUTH_SECRET=dev-auth-secret-must-be-at-least-32-chars
