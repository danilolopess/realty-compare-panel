# Copie para deploy/vps.env e não commite esse arquivo.
# chmod 600 deploy/vps.env

# Senha do Postgres deste app. Só hexadecimal, sem @ : / #.
# Se a linha ficar vazia, deploy.sh gera uma e grava aqui.
POSTGRES_PASSWORD=

# O login de dentro do site (email e senha) fica no .env da raiz:
# AUTH_EMAIL, AUTH_SECRET e AUTH_PASSWORD_HASH.
# Não use os valores de exemplo. Gere com:
#   openssl rand -hex 32
#   npm run hash-password
